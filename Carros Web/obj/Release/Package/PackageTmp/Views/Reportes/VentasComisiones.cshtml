@using System
@using System.Linq
@model IEnumerable<Carros_Web.Models.Venta>
@{
    ViewBag.Title = "Ventas por periodo";
}

@Html.Partial("_TabsReportes")

<h2 class="titulo-seccion">Ventas por periodo</h2>

<form method="get" style="display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin-bottom:16px">
    <div>
        <label style="font-size:13px;font-weight:600;color:#1b3a63;display:block">Desde</label>
        <input type="date" name="desde" value="@(ViewBag.desde == null ? "" : ((DateTime)ViewBag.desde).ToString("yyyy-MM-dd"))" style="padding:8px;border-radius:8px;border:1px solid #d5dbe6" />
    </div>
    <div>
        <label style="font-size:13px;font-weight:600;color:#1b3a63;display:block">Hasta</label>
        <input type="date" name="hasta" value="@(ViewBag.hasta == null ? "" : ((DateTime)ViewBag.hasta).ToString("yyyy-MM-dd"))" style="padding:8px;border-radius:8px;border:1px solid #d5dbe6" />
    </div>
    <button type="submit" class="boton boton--secundario" style="max-width:120px;padding:9px;margin-top:0">Filtrar</button>
</form>

<div class="tarjetas-resumen">
    <div class="tarjeta-resumen">
        <div class="tarjeta-resumen__valor">Q @(((decimal)ViewBag.TotalVentas).ToString("N2"))</div>
        <div class="tarjeta-resumen__etiqueta">Total vendido</div>
    </div>
    <div class="tarjeta-resumen">
        <div class="tarjeta-resumen__valor">Q @(((decimal)ViewBag.TotalComisiones).ToString("N2"))</div>
        <div class="tarjeta-resumen__etiqueta">Comisiones generadas</div>
    </div>
    <div class="tarjeta-resumen">
        <div class="tarjeta-resumen__valor">@Model.Count()</div>
        <div class="tarjeta-resumen__etiqueta">Ventas realizadas</div>
    </div>
</div>

<table class="tabla-datos">
    <thead><tr><th>Fecha</th><th>Vehículo</th><th>Cliente</th><th>Precio</th><th>Comisión</th></tr></thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.fecha.ToString("dd/MM/yyyy")</td>
                <td>@(v.Vehiculo?.placa) — @(v.Vehiculo?.modelo)</td>
                <td>@(v.Cliente?.nombre)</td>
                <td>Q @v.precio_final.ToString("N2")</td>
                <td>Q @v.comision.ToString("N2")</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="texto-tenue">Sin ventas en el periodo seleccionado.</td></tr>
        }
    </tbody>
</table>
