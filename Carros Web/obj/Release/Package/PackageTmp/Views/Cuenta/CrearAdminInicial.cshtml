@using System.Linq
@model Carros_Web.Models.CrearAdminInicialViewModel
@{
    ViewBag.Title = "Crear administrador";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Crear administrador - Concesionaria</title>
    <link href="@Url.Content("~/Content/Concesionaria.css?v=3")" rel="stylesheet" />
</head>
<body class="pantalla-login">
    <div class="tarjeta-login">
        <h1 class="tarjeta-login__titulo">🚗 Concesionaria</h1>
        <p class="tarjeta-login__subtitulo">Primer uso del sistema: crea tu usuario administrador</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alerta alerta--error">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        @using (Html.BeginForm("CrearAdminInicial", "Cuenta", FormMethod.Post, new { @class = "formulario" }))
        {
            @Html.AntiForgeryToken()
            <label for="Nombre">Nombre completo</label>
            @Html.TextBoxFor(m => m.Nombre, new { autofocus = "autofocus" })

            <label for="Correo">Correo</label>
            @Html.TextBoxFor(m => m.Correo)

            <label for="Contrasena">Contraseña</label>
            <div class="campo-contrasena">
                @Html.PasswordFor(m => m.Contrasena)
                <button type="button" class="campo-contrasena__boton" onclick="alternarContrasena('Contrasena', this)" aria-label="Mostrar contraseña">👁️</button>
            </div>

            <button type="submit" class="boton boton--primario">Crear administrador</button>
        }

        @Html.ActionLink("Volver al inicio de sesión", "Login", "Cuenta", null, new { @class = "enlace-secundario" })
    </div>
    <script src="@Url.Content("~/Scripts/site.js")"></script>
</body>
</html>
