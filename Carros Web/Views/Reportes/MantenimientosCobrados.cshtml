@using System
@model IEnumerable<CarrosWeb.Models.Mantenimiento>
@{
    ViewBag.Title = "Mantenimientos cobrados";
    int cantidad = Model.Count();
}

@Html.Partial("_TabsReportes")

<h2 class="titulo-seccion">Servicios de mantenimiento cobrados</h2>
<p class="texto-tenue">Incluye tanto vehículos del inventario como vehículos externos que pasaron por el taller.</p>

<form method="get" style="display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin-bottom:16px">
    <div>
        <label style="font-size:13px;font-weight:600;color:#1b3a63;display:block">Desde</label>
        <input type="date" name="desde" value="@(ViewBag.desde == null ? "" : ((DateTime)ViewBag.desde).ToString("yyyy-MM-dd"))" style="padding:8px;border-radius:8px;border:1px solid #d5dbe6" />
    </div>
    <div>
        <label style="font-size:13px;font-weight:600;color:#1b3a63;display:block">Hasta</label>
        <input type="date" name="hasta" value="@(ViewBag.hasta == null ? "" : ((DateTime)ViewBag.hasta).ToString("yyyy-MM-dd"))" style="padding:8px;border-radius:8px;border:1px solid #d5dbe6" />
    </div>
    <button type="submit" class="boton boton--secundario" style="max-width:120px;padding:9px;margin-top:0">Filtrar</button>
</form>

<div class="tarjetas-resumen">
    <div class="tarjeta-resumen">
        <div class="tarjeta-resumen__valor">Q @(((decimal)ViewBag.TotalCobrado).ToString("N2"))</div>
        <div class="tarjeta-resumen__etiqueta">Total cobrado en servicios</div>
    </div>
    <div class="tarjeta-resumen">
        <div class="tarjeta-resumen__valor">@cantidad</div>
        <div class="tarjeta-resumen__etiqueta">Servicios cobrados</div>
    </div>
</div>

<table class="tabla-datos">
    <tr>
        <th>Fecha de cobro</th>
        <th>Vehículo</th>
        <th>Origen</th>
        <th>Servicio</th>
        <th>Forma de pago</th>
        <th>Cobrado por</th>
        <th>Monto</th>
        <th></th>
    </tr>
    @foreach (var m in Model)
    {
        <tr>
            <td>@(m.fecha_pago?.ToString("dd/MM/yyyy HH:mm"))</td>
            <td>
                @if (m.Vehiculo != null)
                {
                    <text>@(m.Vehiculo.Catalogo_Marca?.descripcion) @m.Vehiculo.modelo (@m.Vehiculo.placa)</text>
                }
                else
                {
                    <text>@m.marca_modelo_ingresado (@m.placa_ingresada)</text>
                }
            </td>
            <td>
                @if (m.Vehiculo != null)
                {
                    <span class="etiqueta etiqueta--disponible">Inventario</span>
                }
                else
                {
                    <span class="etiqueta etiqueta--mantenimiento">Externo</span>
                }
            </td>
            <td>@(m.Catalogo_TipoMantenimiento?.descripcion)</td>
            <td>@(m.Forma_Pago?.descripcion)</td>
            <td>@(m.Usuario?.nombre)</td>
            <td>Q @((m.costo ?? 0).ToString("N2"))</td>
            <td>@Html.ActionLink("Comprobante", "Comprobante", "Mantenimientos", new { id = m.id_mantenimiento }, null)</td>
        </tr>
    }
    @if (cantidad == 0)
    {
        <tr><td colspan="8" class="texto-tenue">Sin servicios cobrados en el periodo seleccionado.</td></tr>
    }
</table>
