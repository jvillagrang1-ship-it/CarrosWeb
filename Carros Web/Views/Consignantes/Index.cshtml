@using System.Linq
@model IEnumerable<CarrosWeb.Models.Consignante>
@{
    ViewBag.Title = "Consignantes";
    var contratos = (List<CarrosWeb.Models.Contrato>)ViewBag.Contratos;
}

<h2 class="titulo-seccion">Consignantes y contratos</h2>
<p class="texto-tenue">Registra aquí a los propietarios. El contrato de consignación (precio, comisión, vigencia) se crea junto con el vehículo en el módulo de Vehículos.</p>

<div class="panel" style="max-width:100%">
    <h3 class="panel__titulo">Nuevo consignante</h3>
    @using (Html.BeginForm("Create", "Consignantes", FormMethod.Post, new { @class = "formulario-vertical" }))
    {
        @Html.AntiForgeryToken()
        <div><label>Nombre completo</label><input type="text" name="nombre" required /></div>
        <div><label>DPI</label><input type="text" name="DPI" required /></div>
        <div><label>Teléfono</label><input type="text" name="telefono" /></div>
        <div><label>Dirección</label><input type="text" name="direccion" /></div>
        <div class="campo-ancho">
            <button type="submit" class="boton boton--primario" style="max-width:200px">Registrar consignante</button>
        </div>
    }
</div>

<h3 class="panel__titulo" style="margin-top:24px">Consignantes registrados</h3>
<table class="tabla-datos">
    <thead><tr><th>Nombre</th><th>DPI</th><th>Teléfono</th><th>Dirección</th><th></th></tr></thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.nombre</td>
                <td>@c.DPI</td>
                <td>@c.telefono</td>
                <td>@c.direccion</td>
                <td style="white-space:nowrap">
                    @Html.ActionLink("Editar", "Edit", new { id = c.id_consignante }, new { @class = "enlace-fila" })
                    @Html.ActionLink("Eliminar", "Delete", new { id = c.id_consignante }, new { @class = "enlace-fila" })
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="texto-tenue">Todavía no hay consignantes registrados.</td></tr>
        }
    </tbody>
</table>

<div class="barra-acciones" style="margin-top:24px">
    <h3 class="panel__titulo" style="margin:0">Contratos de consignación</h3>
    @Html.ActionLink("Administrar contratos", "Index", "Contratos", null, new { @class = "enlace-fila" })
</div>
<table class="tabla-datos">
    <thead><tr><th>Consignante</th><th>Precio pactado</th><th>Comisión</th><th>Vigencia</th><th>Estado</th></tr></thead>
    <tbody>
        @foreach (var c in contratos)
        {
            bool vigente = c.fecha_fin >= DateTime.Today;
            <tr>
                <td>@(c.Consignante?.nombre)</td>
                <td>Q @c.precio_pactado.ToString("N2")</td>
                <td>@c.porcentaje_comision.ToString("0.##")%</td>
                <td>@c.fecha_inicio.ToString("dd/MM/yyyy") - @c.fecha_fin.ToString("dd/MM/yyyy")</td>
                <td>
                    @if (vigente)
                    {
                        <span class="etiqueta etiqueta--disponible">Vigente</span>
                    }
                    else
                    {
                        <span class="etiqueta etiqueta--pendiente">Vencido</span>
                    }
                </td>
            </tr>
        }
        @if (!contratos.Any())
        {
            <tr><td colspan="5" class="texto-tenue">Todavía no hay contratos.</td></tr>
        }
    </tbody>
</table>
