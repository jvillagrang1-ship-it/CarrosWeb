@model Carros_Web.Models.Contrato
@{
    ViewBag.Title = "Detalle del contrato";
}

<h2>Contrato #@Model.id_contrato</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Consignante</dt>
            <dd class="col-sm-9">@(Model.Consignante?.nombre)</dd>
            <dt class="col-sm-3">Precio pactado</dt>
            <dd class="col-sm-9">@Model.precio_pactado.ToString("N2")</dd>
            <dt class="col-sm-3">% Comisión</dt>
            <dd class="col-sm-9">@Model.porcentaje_comision %</dd>
            <dt class="col-sm-3">Vigencia</dt>
            <dd class="col-sm-9">@Model.fecha_inicio.ToString("dd/MM/yyyy") — @Model.fecha_fin.ToString("dd/MM/yyyy")</dd>
        </dl>
    </div>
</div>

<h4 class="mt-3">Vehículos de este contrato</h4>
<table class="table table-sm">
    <tr><th>Placa</th><th>Modelo</th><th>Estado</th></tr>
    @foreach (var v in Model.Vehiculoes)
    {
        <tr>
            <td>@v.placa</td>
            <td>@v.modelo</td>
            <td>@(v.Catalogo_EstadoVehiculo?.descripcion)</td>
        </tr>
    }
</table>

<p>@Html.ActionLink("Volver", "Index", new { idConsignante = Model.id_consignante }, new { @class = "btn btn-outline-secondary" })</p>
